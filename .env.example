# اختياري: مطلوب فقط لسكريبتات الـ migrations (scripts/run-migration.js) اللي بتحتاج DDL مباشر - القيمة من Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.xxxx:password@aws-x-region.pooler.supabase.com:5432/postgres

# مطلوب لـ Customer Auth (JWT مستقل عن worker/admin tokens)
