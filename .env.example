SUPABASE_URL=...
SUPABASE_SERVICE_ROLE_KEY=...
SUPABASE_BUCKET=uploads
SUPABASE_ID_BUCKET=identity-docs
# اختياري: مطلوب فقط لسكريبتات الـ migrations (scripts/run-migration.js) اللي بتحتاج DDL مباشر - القيمة من Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.xxxx:password@aws-x-region.pooler.supabase.com:5432/postgres

# مطلوب لـ Customer Auth (JWT مستقل عن worker/admin tokens)
CUSTOMER_JWT_SECRET=change-this-long-random-secret-at-least-32-characters

ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-long-random-secret-at-least-32-characters
ADMIN_SESSION_DAYS=7

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=change-this-smtp-password
EMAIL_FROM="صنايعي مطروح <no-reply@example.com>"
APP_BASE_URL=https://your-domain.com

PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=egy_sk_test_...
PAYMOB_PUBLIC_KEY=egy_pk_test_...
PAYMOB_HMAC_SECRET=...
PAYMOB_CARD_INTEGRATION_ID=...
PAYMOB_WALLET_INTEGRATION_ID=...
PAYMOB_INTENTION_EXPIRATION=3600
PAYMOB_API_KEY=...

CRON_SECRET=change-this-long-random-secret

# Web Push (VAPID) - إشعارات الجهاز الحقيقية (بند إضافي فوق نظام notifications
# الداخلي). ولّد زوج المفاتيح بالأمر: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# APNs (iOS Native Push عبر Capacitor) - إشعارات الجهاز الحقيقية على تطبيق
# iOS (بند إضافي موازٍ لـ Web Push أعلاه، لا يبدّله). أنشئ APNs Auth Key من
# Apple Developer Portal > Certificates, Identifiers & Profiles > Keys.
# APPLE_APNS_PRIVATE_KEY = محتوى ملف .p8 كامل (يدعم \n مهرّبة كسطر واحد)
#
# APPLE_APNS_PRODUCTION يحدد Endpoint إرسال APNs المستخدَم من السيرفر (مش
# نوع الـBuild نفسه): true = api.push.apple.com (المطلوب لأي Build موقّع
# بشهادة Distribution - وده يشمل TestFlight والـApp Store، مش الـApp Store
# فقط)، false = api.sandbox.push.apple.com (Debug Builds عادية من Xcode على
# جهاز حقيقي فقط). بما إن Vercel هو نفس السيرفر اللي يرسل لكل التوزيعات
# الموقّعة، القيمة الصحيحة في Production على Vercel هي true دايمًا طالما
# التطبيق موزّع عبر TestFlight أو App Store.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=
APPLE_APNS_PRIVATE_KEY=
APPLE_APNS_PRODUCTION=true
